<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT&#xd;&#xa;    MaNV,&#xd;&#xa;    MONTH(NgayChamCong) AS Thang,&#xd;&#xa;    YEAR(NgayChamCong)  AS Nam,&#xd;&#xa;    COUNT(CASE WHEN TrangThai IN (N&apos;CO_MAT&apos;, N&apos;DI_TRE&apos;, N&apos;VE_SOM&apos;) THEN 1 END) AS SoNgayDiLam,&#xd;&#xa;    COUNT(CASE WHEN TrangThai = N&apos;DI_TRE&apos; THEN 1 END) AS SoLanDiTre,&#xd;&#xa;    COUNT(CASE WHEN TrangThai = N&apos;VE_SOM&apos; THEN 1 END) AS SoLanVeSom,&#xd;&#xa;    COUNT(CASE WHEN TrangThai = N&apos;VANG&apos; THEN 1 END) AS SoNgayVang,&#xd;&#xa;    SUM(CASE&#xd;&#xa;        WHEN GioRa IS NOT NULL AND GioRa &gt; GioVao&#xd;&#xa;        THEN DATEDIFF(MINUTE, GioVao, GioRa)&#xd;&#xa;        ELSE 0&#xd;&#xa;    END) / 60.0 AS TongSoGioLam&#xd;&#xa;FROM #CHAMCONG_BENCHMARK WITH (INDEX(IX_Bench_CHAMCONG_MaNV_Ngay))&#xd;&#xa;WHERE MaNV = 25 AND NgayChamCong BETWEEN &apos;2026-01-01&apos; AND &apos;2026-09-30&apos;&#xd;&#xa;GROUP BY MaNV, YEAR(NgayChamCong), MONTH(NgayChamCong)" StatementId="2" StatementCompId="10" StatementType="SELECT" StatementSqlHandle="0x0900BEC3F9F41E0AE7077D44462DA1A567690000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="3" ParentObjectId="0" BatchSqlHandle="0x02000000B3BA4A0DE5AFAEA0E27368BB416036E320BAE3130000000000000000000000000000000000000000" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.0191423" StatementEstRows="12" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xE3C85008EC0EFC33" QueryPlanHash="0xA4F1EC276BCA3A86" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="1024" CachedPlanSize="72" CompileTime="7" CompileCPU="7" CompileMemory="768"><MemoryGrantInfo SerialRequiredMemory="512" SerialDesiredMemory="576" RequiredMemory="512" DesiredMemory="576" RequestedMemory="1024" GrantWaitTime="0" MaxQueryMemory="1497128" GrantedMemory="1024" MaxUsedMemory="32" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="69905" EstimatedPagesCached="52428" EstimatedAvailableDegreeOfParallelism="6" MaxCompileMemory="6041040"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-10-13T14:08:04.91" ModificationCount="0" SamplingPercent="100" Statistics="[IX_Bench_CHAMCONG_MaNV_Ngay]" Table="[#CHAMCONG_BENCHMARK_________________________________________________________________________________________________00000000000F]" Schema="[dbo]" Database="[tempdb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-13T14:08:04.50" ModificationCount="0" SamplingPercent="100" Statistics="[UQ_Bench_MaNV_Ngay]" Table="[#CHAMCONG_BENCHMARK_________________________________________________________________________________________________00000000000F]" Schema="[dbo]" Database="[tempdb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-13T14:08:04.52" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000003_BF791214]" Table="[#CHAMCONG_BENCHMARK_________________________________________________________________________________________________00000000000F]" Schema="[dbo]" Database="[tempdb]"></StatisticsInfo></OptimizerStatsUsage><QueryTimeStats ElapsedTime="0" CpuTime="0"></QueryTimeStats><RelOp NodeId="0" PhysicalOp="Compute Scalar" LogicalOp="Compute Scalar" EstimateRows="12" EstimateIO="0" EstimateCPU="1.2e-06" AvgRowSize="44" EstimatedTotalSubtreeCost="0.0191423" Parallel="0" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Row"><OutputList><Colum